{
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/#/login"
  },
  "sessionTimeout": 60,
  "routes": [
    {
      "source": "^/(?:oauth/token|api/v1/.+)(?:\\?.*)?$",
      "destination": "public-api-destination",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^.*\\.(?:html|xml|js|png|svg|json|properties|css|woff|woff2|ttf)$",
      "destination": "token-destination",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^(?:/irt)?/(?:health|login|restart|v3/api-docs|v3/api-docs/.+|swagger-resources/.+|webjars/.+|api/public/configuration/features|actuator/hawtio|actuator/loggers|tokens/revoke|api/cpi-testing-mock-data/step/.+|api/idp/sign-saml-response/.+|api/api-proxy/record-messages.+).*",
      "destination": "token-destination",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/\\.well-known/(?:oauth-protected-resource|oauth-authorization-server)$",
      "destination": "token-destination",
      "authenticationType": "none",
      "httpMethods": ["GET"],
      "csrfProtection": false
    },
    {
      "source": "^/connect/register$",
      "destination": "token-destination",
      "authenticationType": "none",
      "httpMethods": ["POST"],
      "csrfProtection": false
    },
    {
      "source": "^/oauth2/(?:token|revoke)$",
      "destination": "token-destination",
      "authenticationType": "none",
      "httpMethods": ["POST"],
      "csrfProtection": false
    },
    {
      "source": "^/api/mcp/?$",
      "destination": "token-destination",
      "authenticationType": "none",
      "httpMethods": ["GET", "POST", "DELETE"],
      "csrfProtection": false
    },
    {
      "source": "^/",
      "target": "/",
      "destination": "token-destination",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    }
  ]
}
